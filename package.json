{
  "name": "dsh-llm-chatgpt",
  "version": "0.3.2",
  "description": "Settings-page sign-in for the official openai-codex route in DeepSeek Harness",
  "type": "module",
  "main": "./src/index.js",
  "exports": { ".": "./src/index.js", "./client": "./src/client.js" },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-locale"]
    }
  },
  "files": ["src", "README.md", "LICENSE", "docs"],
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/codex.js && node --check src/management.js && node --check src/client.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-authorization": "0.2.0-rc.2 || 0.2.1-alpha.1"
  },
  "license": "MIT"
}
