{
  "name": "dsh-llm-chatgpt",
  "version": "0.3.8",
  "description": "Settings-page sign-in for the official openai-codex route in DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.ts",
    "prepack": "npm run check && npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-authorization": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2 || 0.2.1-alpha.1"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  }
}
